[configuration]
entry_symbol = "chart_ext_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://gdextension/bin/chart_ext.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://gdextension/bin/chart_ext.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://gdextension/bin/libchart_ext.android.template_debug.arm64.so"
android.release.arm64 = "res://gdextension/bin/libchart_ext.android.template_release.arm64.so"
